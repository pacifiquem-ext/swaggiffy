        },
        "published": {
          "type": "boolean",
          "default": false
        },
        "authorId": {
          "type": "integer",
          "format": "int32"
        },
        "author": {
          "type": "object",
          "description": "Relation to User (authorId → id)",
          "x-references": "User"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "default": "now()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "published",
        "authorId",
        "author",
