          "nullable": true,
          "items": {
            "type": "object"
          },
          "x-references": "Article"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "password",
        "createdAt"
      ]
    },
    "Article": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "default": "autoincrement()"
        },
        "title": {
          "type": "string"
        },
        "content": {
